# ─────────────────────────────────────────────────────────────
#  YouTube Media Engine — environment template
#  Copy to .env and fill in. NOTHING here is baked into the image.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# MOCK_MODE=true runs the ENTIRE pipeline with deterministic fake
# providers: no LLM calls, no TTS spend, no stock API, no YouTube upload.
# Start here. Flip providers to real ones one at a time (see docs/SETUP.md).
MOCK_MODE=true

# ── Infrastructure ───────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/media_engine?schema=public
REDIS_URL=redis://localhost:6379

# ── Auth (web dashboard) ─────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=
# Bootstrap operator account, created by `pnpm db:seed`.
BOOTSTRAP_EMAIL=owner@example.com
BOOTSTRAP_PASSWORD=

# ── LLM ──────────────────────────────────────────────────────
# LLM_PROVIDER: mock | anthropic
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL_REASONING=claude-opus-5
LLM_MODEL_DRAFTING=claude-sonnet-5
LLM_MODEL_CHEAP=claude-haiku-4-5-20251001
# Hard ceiling per pipeline run, USD. Exceeding it fails the job loudly.
LLM_MAX_COST_PER_VIDEO_USD=8.00

# ── Research / web search ────────────────────────────────────
# SEARCH_PROVIDER: mock | brave | tavily
SEARCH_PROVIDER=mock
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# ── Text to speech ───────────────────────────────────────────
# TTS_PROVIDER: mock | elevenlabs | openai
TTS_PROVIDER=mock
TTS_API_KEY=
TTS_VOICE_ID=
TTS_MODEL=
TTS_SPEED=1.0

# ── Images / stock media ─────────────────────────────────────
# IMAGE_PROVIDER: mock | openai
IMAGE_PROVIDER=mock
IMAGE_API_KEY=
# STOCK_PROVIDER: mock | pexels
STOCK_PROVIDER=mock
STOCK_VIDEO_API_KEY=

# ── Object storage (S3-compatible: AWS S3, R2, MinIO, B2) ────
# STORAGE_DRIVER: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── YouTube ──────────────────────────────────────────────────
# YOUTUBE_PROVIDER: mock | google
YOUTUBE_PROVIDER=mock
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# ── Render ───────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# 1080p | 4k
RENDER_RESOLUTION=1080p
RENDER_FPS=30
# Lower = faster renders, larger files. ultrafast..veryslow
RENDER_PRESET=medium

# ── Editorial policy gates ───────────────────────────────────
MINIMUM_TOPIC_SCORE=75
MINIMUM_QC_SCORE=85
# Never flip this to true without reading docs/POLICY.md.
AUTOMATIC_PUBLISH=false
HUMAN_APPROVAL=true
